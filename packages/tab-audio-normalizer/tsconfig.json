{
  "compilerOptions": {
    "target": "es2020",
    "module": "es2020",
    "moduleResolution": "bundler",
    "lib": ["es2020", "dom", "dom.iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "types": ["chrome"],
    "skipLibCheck": true
  },
  "include": [
    "*.js",
    "*.d.ts"
  ],
  "exclude": [
    "tests/*.js"
  ]
}
