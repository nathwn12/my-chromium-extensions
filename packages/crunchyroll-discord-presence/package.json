{
  "name": "crunchyroll-discord-presence",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local-only MV3 extension + native host that publishes Crunchyroll activity to Discord Canary over IPC.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/",
    "key": "node scripts/extension-key.mjs --print",
    "install-host": "node scripts/install-host.mjs",
    "uninstall-host": "node scripts/uninstall-host.mjs",
    "selftest": "node native/host.mjs --selftest"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1"
  }
}
